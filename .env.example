# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# LLM（OpenAI Chat Completions 兼容端点）
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=your-api-key-here
REVIEWFORGE_MODEL=your-model

# 控制台模型配置会加密写入 .reviewforge/llm-settings.enc。
# 可显式设置长期主密钥；留空时服务会生成权限为 0600 的 .reviewforge/master.key。
# REVIEWFORGE_SECRETS_KEY=generate-a-long-random-secret

# 默认禁止模型 Base URL 指向内网，防止控制台被滥用进行 SSRF。
# 仅在确实使用内网模型服务时开启（localhost/127.0.0.1 无需开启）。
REVIEWFORGE_ALLOW_PRIVATE_LLM_ENDPOINTS=0

# API 鉴权（非 mock 模式必填）
REVIEWFORGE_API_TOKEN=your-api-token-here

# CORS（逗号分隔的允许来源）
REVIEWFORGE_CORS_ORIGINS=http://localhost:5173

# 插件加载（默认关闭，=1 开启）
REVIEWFORGE_ENABLE_PLUGINS=0

# 并发审查上限
REVIEWFORGE_MAX_CONCURRENT_REVIEWS=3

# Agentic 工具循环：生产默认采用 reviewforge.yaml 的选择性 allowlist。
# 不建议在小型服务器上把所有 Reviewer 都改为 1，会显著增加延迟与 Token。
REVIEWFORGE_AGENTIC_DEFAULT=0
# 可选 allowlist；未设置时使用 reviewforge.yaml。
# REVIEWFORGE_AGENTIC_REVIEWERS=security_reviewer

# Mock 模式（本地测试用）
# REVIEWFORGE_MOCK=1

# Phase 1 (perf/gate-dedup-20260729): override publication_gate without a
# redeploy.  Bad values fall back to the YAML defaults rather than disabling
# the gate, so an invalid override is safe to leave in the env file.
# Phase 2 (perf/gate-dedup-20260729): ``dedup`` collapses exact
# ``(file, line, category)`` duplicates before triage / gate. Extended semantic
# root-cause families handle neighboring-line aliases and have a separate
# kill switch. Toggle both to ``0`` / ``false`` for the legacy behavior.
# REVIEWFORGE_PUBLICATION_GATE_ENABLED=true|false
# REVIEWFORGE_PUBLICATION_GATE_MAX_STEPS=2
# REVIEWFORGE_PUBLICATION_GATE_MAX_TOKENS=4000
# REVIEWFORGE_PUBLICATION_GATE_CONCURRENCY=4
# REVIEWFORGE_PUBLICATION_GATE_DEDUP=true
# REVIEWFORGE_PUBLICATION_TRIAGE_ENABLED=true|false
# REVIEWFORGE_PUBLICATION_TRIAGE_BATCH_SIZE=6
# REVIEWFORGE_PUBLICATION_TRIAGE_MAX_TOKENS=4000
# REVIEWFORGE_ROOT_CAUSE_EXTENDED_FAMILIES=true
